@page "/pedidos/{Id:guid}"
@using LojaPedidos.Web.Contracts.Pedidos

<PageTitle>Detalhes do pedido</PageTitle>

<MudButton Href="/pedidos"
           Variant="Variant.Text"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Outlined.ArrowBack"
           Class="mb-4">
    Voltar para pedidos
</MudButton>

@if (_carregando)
{
    <div class="loading-state" aria-busy="true">
        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        <span>Carregando pedido...</span>
    </div>
}
else if (_mensagemErro is not null)
{
    <MudPaper Class="pa-5 details-card" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h5" HtmlTag="h1">
            @(_naoEncontrado ? "Pedido não encontrado." : "Não foi possível carregar o pedido.")
        </MudText>
        <MudText Typo="Typo.body2" Class="secondary-text mt-2 mb-4">@_mensagemErro</MudText>
        @if (!_naoEncontrado)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       OnClick="CarregarPedidoAsync">
                Tentar novamente
            </MudButton>
        }
    </MudPaper>
}
else if (_pedido is not null)
{
    <div class="details-header">
        <MudText Typo="Typo.h1" HtmlTag="h1">Pedido</MudText>
        <PedidoStatusBadge Status="_pedido.Status" />
    </div>

    <div class="details-actions mb-4">
        @if (_pedido.Status == StatusPedido.Iniciado)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_executando" OnClick="AtivarEdicao">
                Editar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_executando" OnClick="ProcessarAsync">
                Processar
            </MudButton>
        }
        @if (_pedido.Status == StatusPedido.Processado)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_executando" OnClick="EnviarAsync">
                Enviar
            </MudButton>
        }
        @if (_pedido.Status is StatusPedido.Iniciado or StatusPedido.Processado)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_executando" OnClick="CancelarAsync">
                Cancelar
            </MudButton>
        }
        <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="_executando" OnClick="ExcluirAsync">
            Excluir
        </MudButton>
    </div>

    @if (_mensagemOperacao is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            @_mensagemOperacao
        </MudAlert>
    }

    <MudPaper Class="pa-5 details-card" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">Informações</MudText>
        <dl class="details-grid">
            <div class="full-row">
                <dt>Identificador</dt>
                <dd class="identifier">@_pedido.Id</dd>
            </div>
            <div>
                <dt>Comprador</dt>
                <dd>@_pedido.Comprador</dd>
            </div>
            <div>
                <dt>Data de criação</dt>
                <dd>@FormatarData(_pedido.CriadoEm)</dd>
            </div>
            <div>
                <dt>Itens</dt>
                <dd>@FormatarQuantidade(_pedido.Itens.Count)</dd>
            </div>
            <div>
                <dt>Total</dt>
                <dd class="total-value">@FormatarValor(_pedido.Total)</dd>
            </div>
        </dl>
    </MudPaper>

    <MudPaper Class="items-card mt-5" Elevation="0" Outlined="true">
        <div class="section-heading">
            <MudText Typo="Typo.h6" HtmlTag="h2">Itens do pedido</MudText>
            <MudText Typo="Typo.body2" Class="secondary-text">@FormatarQuantidade(_pedido.Itens.Count)</MudText>
        </div>
        <MudTable T="ItemPedidoResponse"
                  Items="_pedido.Itens"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="0">
            <HeaderContent>
                <MudTh>Produto</MudTh>
                <MudTh>Item ID</MudTh>
                <MudTh>Quantidade</MudTh>
                <MudTh Class="text-right">Preço unitário</MudTh>
                <MudTh Class="text-right">Subtotal</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Produto">
                    <div class="product-cell">
                        <img src="@ObterImagem(item.ImagemUrl)" alt="" />
                        <span class="product-name">@item.Produto</span>
                    </div>
                </MudTd>
                <MudTd DataLabel="Item ID"><span class="item-id">@item.Id</span></MudTd>
                <MudTd DataLabel="Quantidade">
                    @if (_editando)
                    {
                        <MudNumericField T="int"
                                         Value="@ObterQuantidade(item.Id)"
                                         ValueChanged="@(valor => DefinirQuantidade(item.Id, valor))"
                                         Min="1"
                                         Error="@(ObterErroQuantidade(item.Id) is not null)"
                                         ErrorText="@ObterErroQuantidade(item.Id)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Class="quantity-field" />
                    }
                    else
                    {
                        @item.Quantidade
                    }
                </MudTd>
                <MudTd DataLabel="Preço unitário" Class="text-right">@FormatarValor(item.PrecoUnitario)</MudTd>
                <MudTd DataLabel="Subtotal" Class="text-right subtotal-value">@FormatarValor(item.Subtotal)</MudTd>
            </RowTemplate>
        </MudTable>

        @if (_editando)
        {
            <div class="edit-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_executando" OnClick="SalvarAlteracoesAsync">
                    Salvar
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="_executando" OnClick="CancelarEdicao">
                    Voltar
                </MudButton>
            </div>
        }
    </MudPaper>
}
