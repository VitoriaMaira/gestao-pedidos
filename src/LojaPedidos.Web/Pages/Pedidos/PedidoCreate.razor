@page "/pedidos/novo"

<PageTitle>Novo pedido</PageTitle>

<MudText Typo="Typo.h1" HtmlTag="h1">Novo pedido</MudText>
<MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);" Class="mt-2 mb-6">
    Informe o comprador e os produtos para registrar um pedido.
</MudText>

<MudPaper Class="pa-8 text-center" Elevation="0" Outlined="true">
    <MudIcon Icon="@Icons.Material.Outlined.AddShoppingCart" Size="Size.Large" Color="Color.Secondary" />
    <MudText Typo="Typo.h4" Class="mt-3">Formulário de criação</MudText>
    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);" Class="mt-2">
        O formulário será construído depois da listagem e dos detalhes.
    </MudText>
</MudPaper>

