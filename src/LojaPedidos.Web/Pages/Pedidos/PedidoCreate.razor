@page "/pedidos/novo"

<PageTitle>Novo pedido</PageTitle>

<MudButton Href="/pedidos"
           Variant="Variant.Text"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Outlined.ArrowBack"
           Class="mb-4">
    Voltar para pedidos
</MudButton>

<div class="page-header">
    <MudText Typo="Typo.h1" HtmlTag="h1">Novo pedido</MudText>
</div>

@if (_mensagemErro is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5">
        <MudText Typo="Typo.body1">@_mensagemErro</MudText>
        @if (_errosApi.Count > 0)
        {
            <ul class="api-errors">
                @foreach (var erro in _errosApi)
                {
                    <li>@erro</li>
                }
            </ul>
        }
    </MudAlert>
}

<MudForm @ref="_form" @bind-IsValid="_formularioValido">
    <MudPaper Class="form-card pa-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-4">Comprador</MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="7">
                <MudTextField T="string"
                              @bind-Value="_comprador.Nome"
                              Label="Nome completo"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Informe o nome do comprador."
                              Error="@TemErroApi("Comprador.Nome")"
                              ErrorText="@ObterErroApi("Comprador.Nome")"
                              MaxLength="150"
                              Counter="150"
                              Disabled="_salvando" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudTextField T="string"
                              @bind-Value="_comprador.Cpf"
                              Label="CPF"
                              Placeholder="Somente números"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Informe o CPF do comprador."
                              Error="@TemErroApi("Comprador.Cpf")"
                              ErrorText="@ObterErroApi("Comprador.Cpf")"
                              Validation="@(new Func<string?, string?>(ValidarCpf))"
                              Mask="_mascaraCpf"
                              MaxLength="14"
                              Disabled="_salvando" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="form-card pa-4 mt-4" Elevation="0" Outlined="true">
        <div class="items-heading">
            <MudText Typo="Typo.h6" HtmlTag="h2">Produtos</MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Add"
                       Disabled="_salvando"
                       OnClick="AdicionarItem">
                Adicionar produto
            </MudButton>
        </div>

        <div class="items-list">
            @foreach (var item in _itens)
            {
                <MudPaper @key="item.Id" Class="item-card pa-4" Elevation="0" Outlined="true">
                    <div class="item-number">
                        <MudText Typo="Typo.subtitle2">Item @(_itens.IndexOf(item) + 1)</MudText>
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Disabled="_salvando || _itens.Count == 1"
                                       OnClick="@(() => RemoverItem(item))"
                                       aria-label="@($"Remover item {_itens.IndexOf(item) + 1}")" />
                    </div>

                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          @bind-Value="item.NomeProduto"
                                          Label="Nome do produto"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Informe o nome do produto."
                                          Error="@TemErroApi($"Itens[{_itens.IndexOf(item)}].Produto.Nome")"
                                          ErrorText="@ObterErroApi($"Itens[{_itens.IndexOf(item)}].Produto.Nome")"
                                          MaxLength="150"
                                          Disabled="_salvando" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="item.Preco"
                                             Label="Preço"
                                             Variant="Variant.Outlined"
                                             Required="true"
                                             RequiredError="Informe o preço."
                                             Error="@TemErroApi($"Itens[{_itens.IndexOf(item)}].Produto.Preco")"
                                             ErrorText="@ObterErroApi($"Itens[{_itens.IndexOf(item)}].Produto.Preco")"
                                             Min="0.01M"
                                             Format="N2"
                                             Culture="@CulturaBrasileira"
                                             Disabled="_salvando"
                                             Adornment="Adornment.Start"
                                             AdornmentText="R$" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="int?"
                                             @bind-Value="item.Quantidade"
                                             Label="Quantidade"
                                             Variant="Variant.Outlined"
                                             Required="true"
                                             RequiredError="Informe a quantidade."
                                             Error="@TemErroApi($"Itens[{_itens.IndexOf(item)}].Quantidade")"
                                             ErrorText="@ObterErroApi($"Itens[{_itens.IndexOf(item)}].Quantidade")"
                                             Min="1"
                                             Disabled="_salvando" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
        </div>
    </MudPaper>

    <MudPaper Class="order-summary pa-4 mt-4" Elevation="0" Outlined="true">
        <div>
            <MudText Typo="Typo.subtitle2">Total estimado</MudText>
            <MudText Typo="Typo.body2" Class="summary-caption">
                @TextoQuantidadeItens
            </MudText>
        </div>
        <MudText Typo="Typo.h5" HtmlTag="p">@FormatarValor(TotalEstimado)</MudText>
    </MudPaper>

    <div class="form-actions">
        <MudButton Href="/pedidos"
                   Variant="Variant.Text"
                   Color="Color.Primary"
                   Disabled="_salvando">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   Disabled="_salvando"
                   OnClick="CriarPedidoAsync">
            @if (_salvando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Criando pedido...</span>
            }
            else
            {
                <span>Criar pedido</span>
            }
        </MudButton>
    </div>
</MudForm>
