@page "/pedidos"
@using LojaPedidos.Web.Contracts.Pedidos

<PageTitle>Pedidos</PageTitle>

<div class="page-header">
    <div>
        <MudText Typo="Typo.h1" HtmlTag="h1">Pedidos</MudText>
        <MudText Typo="Typo.body1" Class="page-description">
            Consulte e filtre os pedidos cadastrados.
        </MudText>
    </div>

</div>

<MudPaper Class="filters-card pa-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Filtros</MudText>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <MudTextField T="string"
                          @bind-Value="_cpf"
                          Label="CPF do comprador"
                          Placeholder="Digite somente os números"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Immediate="true"
                          OnKeyDown="TratarTeclaDoFiltroAsync" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="StatusPedido?"
                       @bind-Value="_status"
                       Label="Status do pedido"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                @foreach (var status in Enum.GetValues<StatusPedido>())
                {
                    <MudSelectItem T="StatusPedido?" Value="@((StatusPedido?)status)">
                        @status
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <div class="filter-actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.Search"
                           Disabled="_carregando"
                           OnClick="AplicarFiltrosAsync">
                    Buscar
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Disabled="_carregando || !TemFiltros"
                           OnClick="LimparFiltrosAsync">
                    Limpar
                </MudButton>
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_carregando)
{
    <div class="loading-state" aria-busy="true">
        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        <span>Carregando pedidos...</span>
    </div>
}
else if (_mensagemErro is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <div class="error-content">
            <span>@_mensagemErro</span>
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       OnClick="CarregarPedidosAsync">
                Tentar novamente
            </MudButton>
        </div>
    </MudAlert>
}
else if (_pedidos.Count == 0)
{
    <MudPaper Class="empty-state pa-5" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" HtmlTag="h2">Nenhum pedido encontrado.</MudText>
        @if (TemFiltros)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Class="mt-2"
                       OnClick="LimparFiltrosAsync">
                Limpar filtros
            </MudButton>
        }
    </MudPaper>
}
else
{
    <MudPaper Class="content-card" Elevation="0" Outlined="true">
        <div class="list-summary">
            <MudText Typo="Typo.body1">@TextoDoResumo</MudText>

            <MudSelect T="int"
                       Value="_tamanhoPagina"
                       ValueChanged="AlterarTamanhoPaginaAsync"
                       Label="Por página"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="page-size-select">
                <MudSelectItem T="int" Value="10">10</MudSelectItem>
                <MudSelectItem T="int" Value="20">20</MudSelectItem>
                <MudSelectItem T="int" Value="50">50</MudSelectItem>
            </MudSelect>
        </div>

        <MudTable T="PedidoResponse"
                  Items="_pedidos"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="0"
                  Class="orders-table">
            <HeaderContent>
                <MudTh>Pedido</MudTh>
                <MudTh>Comprador</MudTh>
                <MudTh>Data</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Itens</MudTh>
                <MudTh Class="text-right">Total</MudTh>
                <MudTh>Ações</MudTh>
            </HeaderContent>
            <RowTemplate Context="pedido">
                <MudTd DataLabel="Pedido">
                    <MudTooltip Text="@pedido.Id.ToString()">
                        <span class="order-code">#@ObterCodigo(pedido.Id)</span>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Comprador">
                    <span class="buyer-name">@pedido.Comprador</span>
                </MudTd>
                <MudTd DataLabel="Data">@FormatarData(pedido.CriadoEm)</MudTd>
                <MudTd DataLabel="Status">
                    <PedidoStatusBadge Status="pedido.Status" />
                </MudTd>
                <MudTd DataLabel="Itens">@FormatarQuantidadeDeItens(pedido.Itens.Count)</MudTd>
                <MudTd DataLabel="Total" Class="text-right total-value">
                    @FormatarValor(pedido.Total)
                </MudTd>
                <MudTd DataLabel="Ações">
                    <MudButton Href="@($"/pedidos/{pedido.Id}")"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small">
                        Ver detalhes
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (TotalDePaginas > 1)
        {
            <div class="pagination-area">
                <MudPagination Count="TotalDePaginas"
                               Selected="_pagina"
                               SelectedChanged="AlterarPaginaAsync"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </div>
        }
    </MudPaper>
}
