@page "/pedidos"

<PageTitle>Pedidos</PageTitle>

<MudText Typo="Typo.h1" HtmlTag="h1">Pedidos</MudText>
<MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);" Class="mt-2 mb-6">
    Consulte e acompanhe os pedidos da loja.
</MudText>

<MudPaper Class="pa-8 text-center" Elevation="0" Outlined="true">
    <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Large" Color="Color.Secondary" />
    <MudText Typo="Typo.h4" Class="mt-3">Listagem de pedidos</MudText>
    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);" Class="mt-2">
        A integração com a API será adicionada na próxima etapa.
    </MudText>
</MudPaper>

